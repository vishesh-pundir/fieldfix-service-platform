{
  "name": "fieldfix",
  "version": "1.0.0",
  "private": true,
  "description": "FieldFix service booking and technician dispatch platform",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node server/src/server.js",
    "client:dev": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "db:start": "node scripts/mongodb.js start",
    "db:stop": "node scripts/mongodb.js stop",
    "start": "node server/src/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
