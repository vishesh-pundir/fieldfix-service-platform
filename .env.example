# Choose mongo for persistent storage after setting MONGODB_URI.
STORAGE_MODE=memory
PORT=5001
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/fieldfix

# Make bcrypt hashes and an AUTH_SECRET with the commands in README.md.
ADMIN_EMAIL=admin@fieldfix.local
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
DISPATCHER_EMAIL=
DISPATCHER_PASSWORD_HASH=
AUTH_SECRET=replace-with-a-long-random-secret
